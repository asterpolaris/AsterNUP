	<array>
		<dict><key>ProfileName</key><string>ExtendedGamepad</string></dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>NUP game package</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>com.asterpolaris.nup</string></array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.asterpolaris.nup</string>
			<key>UTTypeDescription</key><string>NUP game package</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>nup</string></array></dict>
		</dict>
	</array>
</dict>
</plist>
