<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: AsterNUP runs the backend's Python build tools, writes each nxnative game's
	     preferences domain (its saved choices) and launches game apps. -->
	<key>com.apple.security.app-sandbox</key><false/>
</dict>
</plist>
